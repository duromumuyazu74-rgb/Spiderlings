root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Preserve existing runtime line endings to retain published package bytes.
# New files should use LF; bulk normalization belongs in a separate change.
