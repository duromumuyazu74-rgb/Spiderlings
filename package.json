{
  "name": "spiderlings-maintenance",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node .github/scripts/check-repository.mjs",
    "test": "node --test .github/scripts/check-repository.test.mjs",
    "test:public": "node KinkyDungeon-Spiderlings/tools/run-spiderlings-tests.js public",
    "test:affected": "node KinkyDungeon-Spiderlings/tools/run-spiderlings-tests.js affected",
    "check:modules": "node KinkyDungeon-Spiderlings/tools/check-spiderlings-modules.js",
    "test:local": "node KinkyDungeon-Spiderlings/tools/run-spiderlings-tests.js all",
    "test:compatibility": "node KinkyDungeon-Spiderlings/tools/verify-kd-compatibility.js",
    "audit:text": "node KinkyDungeon-Spiderlings/tools/audit-spiderlings-text.js",
    "diagnose:save": "node KinkyDungeon-Spiderlings/tools/save-diagnostics.js",
    "diagnose:replay": "node KinkyDungeon-Spiderlings/tools/replay-spiderlings-save.js",
    "diagnose:evidence": "node KinkyDungeon-Spiderlings/tools/evidence-summary.js",
    "run:task": "node KinkyDungeon-Spiderlings/tools/task-runner.js",
    "report:delivery": "node KinkyDungeon-Spiderlings/tools/report-spiderlings-delivery.js",
    "audit:closeout": "node KinkyDungeon-Spiderlings/tools/audit-delivery-closeout.js",
    "verify:publication": "node KinkyDungeon-Spiderlings/tools/verify-spiderlings-publication.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
